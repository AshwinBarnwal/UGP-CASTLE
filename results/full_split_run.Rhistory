library(Matrix)
output_dir <- "D:/ugp/results/full_split_batches"
result_files <- list.files(
  output_dir,
  pattern = "^split_batch_[0-9]+\\.rds$",
  full.names = TRUE
)
result_files <- sort(result_files)
length(result_files)
basename(result_files)
purified_batches <- vector(
  "list",
  length(result_files)
)
metadata_batches <- vector(
  "list",
  length(result_files)
)
for (i in seq_along(result_files)) {
  message("Loading batch ", i, "/", length(result_files))
  batch <- readRDS(result_files[i])
  purified_batches[[i]] <- batch$purified_counts
  metadata_batches[[i]] <- batch$cell_meta
  rm(batch)
  gc()
}
gene_sets_identical <- vapply(
  purified_batches,
  function(x) identical(
    rownames(x),
    rownames(purified_batches[[1]])
  ),
  logical(1)
)
gene_sets_identical
stopifnot(all(gene_sets_identical))
purified_counts_full <- do.call(
  cbind,
  purified_batches
)
dim(purified_counts_full)
class(purified_counts_full)
cell_metadata_full <- do.call(
  rbind,
  metadata_batches
)
stopifnot(
  !anyDuplicated(colnames(purified_counts_full)),
  !anyDuplicated(rownames(cell_metadata_full)),
  all(
    colnames(purified_counts_full) %in%
      rownames(cell_metadata_full)
  )
)
cell_metadata_full <- cell_metadata_full[
  colnames(purified_counts_full),
  ,
  drop = FALSE
]
stopifnot(
  identical(
    colnames(purified_counts_full),
    rownames(cell_metadata_full)
  )
)
manifest <- read.csv(
  file.path(output_dir, "manifest.csv")
)
stopifnot(
  ncol(purified_counts_full) ==
    sum(manifest$cells),
  nrow(purified_counts_full) ==
    unique(manifest$genes)
)
c(
  matrix_total = sum(purified_counts_full),
  manifest_total = sum(manifest$purified_total),
  difference =
    sum(purified_counts_full) -
    sum(manifest$purified_total)
)
combined_output <- list(
  purified_counts = purified_counts_full,
  cell_meta = cell_metadata_full,
  run_summary = list(
    dataset = "Xenium FFPE Human Breast Cancer Replicate 1",
    method = "SPLIT core purification",
    split_version = as.character(
      packageVersion("SPLIT")
    ),
    cells = ncol(purified_counts_full),
    genes = nrow(purified_counts_full),
    fraction_removed =
      1 -
      sum(manifest$purified_total) /
      sum(manifest$raw_total),
    used_precomputed_RCTD = TRUE
  )
)
combined_path <-
  "D:/ugp/results/xenium_rep1_split_full_combined.rds"
saveRDS(
  combined_output,
  combined_path,
  compress = FALSE
)
file.info(combined_path)$size / 1024^2
combined_output$run_summary
dim(combined_output$purified_counts)
head(combined_output$cell_meta)
rm(
  purified_batches,
  metadata_batches,
  combined_output
)
gc()
writeLines(
  capture.output(sessionInfo()),
  "D:/ugp/results/session_info_full_split.txt"
)
savehistory(
  "D:/ugp/results/full_split_run.Rhistory"
)
